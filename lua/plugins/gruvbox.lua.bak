return {
    {
        "sainnhe/gruvbox-material",
        config = function()
            vim.o.background = "dark"           -- must be "dark"
			vim.g.gruvbox_material_transparent_background = 1  -- makes the background fully black
            vim.o.termguicolors = true          -- true colors

            -- gruvbox-material options
            vim.g.gruvbox_material_background = "hard"  -- dark flavor: soft, medium, hard
            vim.g.gruvbox_material_enable_italic = 1
            vim.g.gruvbox_material_enable_bold = 1
            vim.g.gruvbox_material_foreground = "mix"   -- optional, better contrast

            vim.cmd("colorscheme gruvbox-material")
        end
    }
}

